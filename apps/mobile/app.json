{
  "expo": {
    "name": "Multiplayer Cooking",
    "slug": "multiplayer-cooking",
    "version": "0.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "multiplayer-cooking",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.multiplayer-cooking"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0e7c77",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.MODIFY_AUDIO_SETTINGS"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f3eee4",
          "image": "./assets/splash-icon.png",
          "imageWidth": 96
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Дозволь доступ до фото, щоб додати знімок страви чи продуктів до розмови.",
          "cameraPermission": "Дозволь доступ до камери, щоб сфотографувати страву чи продукти для розмови.",
          "microphonePermission": false
        }
      ],
      "expo-notifications",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
