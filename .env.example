# Public browser configuration. `bunx convex dev` manages this in .env.local.
VITE_CONVEX_URL=

# Convex server variables. Set these on each Convex deployment. Never put secrets in VITE_* variables.
# Required for AI generation.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Optional server-side Axiom ingestion.
AXIOM_TOKEN=
AXIOM_DATASET=
AXIOM_EDGE=

# Self-hosted SearXNG used by the agent for web search and dish photos.
SEARXNG_URL=
