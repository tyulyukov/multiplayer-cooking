{
  "name": "multiplayer-cooking",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun --cwd apps/backend dev:with-web",
    "dev:web": "bun --cwd apps/web dev",
    "storybook": "bun --cwd apps/web storybook",
    "build:storybook": "bun --cwd apps/web build:storybook",
    "dev:backend": "bun --cwd apps/backend dev",
    "build": "bun --cwd apps/web build",
    "typecheck": "bun --cwd packages/theme typecheck && bun --cwd apps/backend typecheck && bun --cwd apps/web typecheck",
    "lint": "oxlint --deny-warnings apps packages",
    "lint:fix": "oxlint apps packages --fix",
    "format": "oxfmt apps packages *.md *.json",
    "format:check": "oxfmt apps packages *.md *.json --check",
    "test": "bun test apps packages",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test && bun run build",
    "preview": "bun --cwd apps/web preview",
    "deploy:backend": "bun --cwd apps/backend deploy"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "@types/node": "^24.13.3",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2"
  },
  "packageManager": "bun@1.3.11"
}
